{
    "name": "node-red-contrib-grohe-sense",
    "version": "0.34.1",
    "description": "Grohe sense nodes via ondus API.",
    "node-red": {
        "version": ">=0.1.0",
        "nodes": {
            "grohe": "grohe/99-grohe.js"
        }
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "files": [
        "grohe/",
        "examples/",
        "CHANGELOG.md"
    ],
    "scripts": {
        "lint": "eslint .",
        "test": "node --test --test-force-exit --test-timeout=30000 --test-concurrency=1",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "coverage": "c8 npm test",
        "coverage:check": "c8 --check-coverage npm test"
    },
    "keywords": [
        "node-red",
        "grohe",
        "ondus",
        "sense"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/windkh/node-red-contrib-grohe-sense"
    },
    "author": "Karl-Heinz Wind",
    "license": "MIT",
    "dependencies": {
        "he": "^1.2.0",
        "superagent": "^7.0.2",
        "url": "^0.11.0"
    },
    "c8": {
        "reporter": [
            "text",
            "lcov"
        ],
        "lines": 65,
        "statements": 65,
        "branches": 85,
        "functions": 50
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "c8": "^10.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.0.0",
        "globals": "^15.0.0",
        "node-red-node-test-helper": "^0.3.4",
        "prettier": "^3.0.0"
    }
}
